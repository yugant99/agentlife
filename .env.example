TELEMETRY_PORT=4174
# Provider reads retain this window of the scoped project's history (seven days) so
# previously observed sessions still appear in their halls. The client marks anything
# older than six hours as historical, so retained history is never shown as live-active.
TELEMETRY_RETENTION_MINUTES=10080
# Finite upper bound on the listed history. Retained records are still filtered by the
# provider's own updatedAt, so this only caps the one-page read.
TELEMETRY_LIST_LIMIT=200

# Scope all adapters without reading the repository contents.
COMMAND_CENTER_SCOPE_CWD=/absolute/path/to/project
COMMAND_CENTER_LEAD_THREAD_ID=

# Optional binary overrides. Defaults use PATH.
CODEX_BIN=codex
OPENCODE_BIN=opencode

# No provider password is needed. The server uses local authenticated CLIs only.
